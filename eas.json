{
  "cli": {
    "version": ">= 7.6.1"
  },
  "build": {
    "development": {
      "env": {
        "TWITCH_TOKEN": "TWITCH_TOKEN",
        "TWITCH_CLIENT_ID": "TWITCH_CLIENT_ID"
      },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "env": {
        "TWITCH_TOKEN": "TWITCH_TOKEN",
        "TWITCH_CLIENT_ID": "TWITCH_CLIENT_ID",
        "GOOGLE_SERVICES_JSON": "GOOGLE_SERVICES_JSON"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "env": {
        "TWITCH_TOKEN": "TWITCH_TOKEN",
        "TWITCH_CLIENT_ID": "TWITCH_CLIENT_ID"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
